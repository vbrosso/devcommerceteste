{% style %}
#section-{{ section.id }} .ru-overlay__wrapper {
  position: relative;
  min-height: {{ section.settings.image_height_mobile }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
}
#section-{{ section.id }} .ru-overlay__wrapper::before {
  content: "";
  {%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
  background-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }};
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
#section-{{ section.id }} .ru-overlay__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 10px;
  box-sizing: border-box;
}
#section-{{ section.id }} .Section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top_movil }}px;
  padding-bottom: {{ section.settings.padding_bottom_movil }}px;
}
#section-{{ section.id }} .Heading__Font-{{ section.id }} {
  position: relative;
  font-family: var(--heading-font-family, inherit);
  font-size: {{ section.settings.heading_font_size_mobile }}px !important;
  color: {{ section.settings.heading_font_color }} !important;
  line-height: 1;
  font-weight: var(--heading-font-weight, 700);
  font-style: var(--heading-font-style, normal);
  text-align: center;
  letter-spacing: -0.02em;
  margin: 0;
}
#section-{{ section.id }} .SubHeading__Font-{{ section.id }} p {
  position: relative;
  font-size: {{ section.settings.subheading_font_size_mobile }}px !important;
  color: {{ section.settings.subheading_font_color }} !important;
  line-height: 1.2;
  font-weight: 400;
  text-align: center;
  margin: 12px 0 0;
}
#section-{{ section.id }} .Footer__Font-{{ section.id }} {
  position: relative;
  font-size: {{ section.settings.footer_font_size_mobile }}px !important;
  color: {{ section.settings.footer_font_color }} !important;
  line-height: 1;
  font-weight: 500;
  letter-spacing: -0.02em;
  text-align: center;
  margin: 12px 0 0;
}
#section-{{ section.id }} .ru-overlay__btn-wrap {
  margin-top: 24px;
  text-align: center;
}
#section-{{ section.id }} .ru-overlay__btn {
  display: inline-block;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  color: var(--button-text-color, #fff);
  background-color: var(--button-background, #000);
  border: 1px solid var(--button-background, #000);
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s ease;
}
#section-{{ section.id }} .ru-overlay__btn:hover {
  opacity: 0.9;
}
@media (min-width: 641px) {
  #section-{{ section.id }} .ru-overlay__wrapper {
    min-height: {{ section.settings.image_height_desktop }}px;
  }
  #section-{{ section.id }} .ru-overlay__inner {
    padding: 0 30px;
  }
  #section-{{ section.id }} .Section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }
  #section-{{ section.id }} .Heading__Font-{{ section.id }} {
    font-size: {{ section.settings.heading_font_size_desktop }}px !important;
  }
  #section-{{ section.id }} .SubHeading__Font-{{ section.id }} p {
    font-size: {{ section.settings.subheading_font_size_desktop }}px !important;
  }
  #section-{{ section.id }} .Footer__Font-{{ section.id }} {
    font-size: {{ section.settings.footer_font_size_desktop }}px !important;
  }
}
{% endstyle %}

<section id="section-{{ section.id }}" class="Section-{{ section.id }}-padding">
  <div class="ru-overlay__wrapper" style="background-image: url('{{ section.settings.image | img_url: 'master' }}');">
    <header class="ru-overlay__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="Heading__Font-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="SubHeading__Font-{{ section.id }}">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if section.settings.footer != blank -%}
        <p class="Footer__Font-{{ section.id }}">{{ section.settings.footer }}</p>
      {%- endif -%}
      {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
        <div class="ru-overlay__btn-wrap">
          <a href="{{ section.settings.button_url }}" class="ru-overlay__btn">{{ section.settings.button_text }}</a>
        </div>
      {%- endif -%}
    </header>
  </div>
</section>

